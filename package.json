{
    "name": "discourse-mcp",
    "version": "1.0.0",
    "description": "discourse mcp based on discourse user api",
    "main": "src/index.ts",
    "files": [
        "build"
    ],
    "scripts": {
        "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=build/index.js --banner:js=\"#!/usr/bin/env node\""
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/runoneall/discourse-mcp.git"
    },
    "keywords": [
        "discourse",
        "mcp"
    ],
    "type": "module",
    "bin": {
        "discourse-mcp": "./build/index.js"
    },
    "bugs": {
        "url": "https://github.com/runoneall/discourse-mcp/issues"
    },
    "homepage": "https://github.com/runoneall/discourse-mcp#readme",
    "dependencies": {
        "@modelcontextprotocol/server": "^2.2.0",
        "axios": "^1.20.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/node": "^26.6.3",
        "esbuild": "^0.28.2",
        "typescript": "^7.0.2"
    }
}
